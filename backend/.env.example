# Copy this file to .env and fill in real values. Never commit .env to git.

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=smart_cv_platform

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# External Job API (Adzuna: https://developer.adzuna.com/)
ADZUNA_APP_ID=your_app_id
ADZUNA_APP_KEY=your_app_key
ADZUNA_COUNTRY=za
